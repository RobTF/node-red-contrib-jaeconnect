        "id": "f1",
        "type": "function",
        "name": "below 50%?",
        "func": "const percent = msg.payload.battery_percent;\nif (percent === null || percent >= 50) {\n    return null;\n}\nmsg.payload = `The car is at ${percent}%. Plug it in?`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
